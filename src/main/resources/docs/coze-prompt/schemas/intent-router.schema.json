{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["intent", "confidence"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "CONTINUE_CONSULTATION",
        "READY_FOR_SKILL_ASSESSMENT",
        "ASK_CAREER_QUESTION",
        "UPDATE_PROFILE",
        "OFF_TOPIC",
        "REQUEST_SKIP"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reply": { "type": "string" },
    "slots": { "type": "object" }
  },
  "additionalProperties": true
}
