{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["类型", "题干", "选项"],
        "properties": {
          "类型": { "type": "string", "enum": ["选择题"] },
          "题干": { "type": "string" },
          "本题主维度": { "type": "string", "enum": ["R", "I", "A", "S", "E", "C"] },
          "本题副维度": { "type": "string", "enum": ["R", "I", "A", "S", "E", "C"] },
          "选项": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["key", "text", "计分"],
              "properties": {
                "key": { "type": "string", "enum": ["A", "B", "C", "D"] },
                "text": { "type": "string" },
                "计分": {
                  "type": "object",
                  "required": ["主维", "副维"],
                  "properties": {
                    "主维": { "type": "string", "enum": ["R", "I", "A", "S", "E", "C"] },
                    "副维": { "type": "string", "enum": ["R", "I", "A", "S", "E", "C"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
